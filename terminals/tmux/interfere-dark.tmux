# Interfere Dark — generated from Radix by interfere-theme
# Color palette as tmux user options; the status-line layout lives in the
# consumer's tmux.conf (which reads these @thm_* vars).
set -g @thm_bg "#0a0a0a"
set -g @thm_bar_bg "#191919"
set -g @thm_fg "#eeeeee"
set -g @thm_fg_dim "#b4b4b4"
set -g @thm_fg_muted "#6e6e6e"
set -g @thm_accent "#0090ff"
set -g @thm_accent_fg "#0a0a0a"
set -g @thm_border "#3a3a3a"
set -g @thm_border_active "#0090ff"
set -g @thm_inactive_bg "#222222"
set -g @thm_sel_bg "#004074"
set -g @thm_ok "#46a758"
set -g @thm_warn "#ffc53d"
set -g @thm_error "#e5484d"
set -g @thm_info "#0090ff"

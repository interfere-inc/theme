# Interfere Light — generated from Radix by interfere-theme
# Color palette as tmux user options; the status-line layout lives in the
# consumer's tmux.conf (which reads these @thm_* vars).
set -g @thm_bg "#fcfcfc"
set -g @thm_bar_bg "#f9f9f9"
set -g @thm_fg "#202020"
set -g @thm_fg_dim "#646464"
set -g @thm_fg_muted "#8d8d8d"
set -g @thm_accent "#0090ff"
set -g @thm_accent_fg "#fcfcfc"
set -g @thm_border "#d9d9d9"
set -g @thm_border_active "#0090ff"
set -g @thm_inactive_bg "#f0f0f0"
set -g @thm_sel_bg "#c2e5ff"
set -g @thm_ok "#46a758"
set -g @thm_warn "#ffc53d"
set -g @thm_error "#e5484d"
set -g @thm_info "#0090ff"
